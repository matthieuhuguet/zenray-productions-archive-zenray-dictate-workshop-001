  max_label_anchor_dist: Math.round(maxDist * 10) / 10,\n    labels_out_of_bounds: oob,\n    angular_variance: Math.round(angularVar * 1000) / 1000,\n  };\n}\n\n/**\n * Scans the mask canvas to find the closest non-transparent pixel to [startX, startY].\n * @param {!HTMLCanvasElement} canvas The mask canvas.\n * @param {number} startX The natural X coordinate.\n * @param {number} startY The natural Y coordinate.\n * @return {?{x: number, y: number}} The closest non-transparent pixel coordinates, or null.\n */\nfunction findNearestMaskPixel(canvas, startX, startY) {\n  const ctx = canvas.getContext('2d');\n  const width = canvas.width;\n  const height = canvas.height;\n  const imgData = ctx.getImageData(0, 0, width, height);\n  const data = imgData.data;\n\n  const queue = [{x: startX, y: startY}];\n  const visited = new Set();\n  visited.add(`${startX},${startY}`);\n\n  const directions = [\n    {dx: 0, dy: 1}, {dx: 1, dy: 0}, {dx: 0, dy: -1}, {dx: -1, dy: 0},\n    {dx: 1, dy: 1}, {dx: 1, dy: -1}, {dx: -1, dy: 1}, {dx: -1, dy: -1}\n  ];\n\n  // Cap iterations to prevent main-thread freeze on empty/corrupt canvases.\n  // 50k iterations covers a ~250px radius search \u2014 more than enough for dot snapping.\n  const MAX_ITERATIONS = 50000;\n  let head = 0;\n  while (head < queue.length && head < MAX_ITERATIONS) {\n    const curr = queue[head++];\n    \n    if (curr.x >= 0 && curr.x < width && curr.y >= 0 && curr.y < height) {\n      const idx = (curr.y * width + curr.x) * 4;\n      if (isWhitePixel(data[idx], data[idx + 1], data[idx + 2])) {\n        return curr; // Found the closest pixel!\n      }\n      \n      for (const dir of directions) {\n        const nx = curr.x + dir.dx;\n        const ny = curr.y + dir.dy;\n        const key = `${nx},${ny}`;\n        if (!visited.has(key)) {\n          visited.add(key);\n          queue.push({x: nx, y: ny});\n        }\n      }\n    }\n  }\n  return null;\n}\n\n// =========================================\n// Inline Conversation Anchor Management\n// =========================================\n\n/**\n * Normalizes an anchor object to standard schema.\n * Supports both camelCase and snake_case properties.\n * @param {!Object} data\n * @return {?Object}\n */\nfunction normalizeAnchor(data) {\n  if (!data) return null;\n  const conversationId = data.conversationId || data.conversation_id || data.id;\n  if (!conversationId) return null;\n  const nodeId = data.nodeId !== undefined ?\n      data.nodeId :\n      (data.node_id !== undefined ? data.node_id : currentNodeId);\n  const naturalX = Number(\n      data.naturalX !== undefined ?\n          data.naturalX :\n          (data.natural_x !== undefined ? data.natural_x : 0));\n  const naturalY = Number(\n      data.naturalY !== undefined ?\n          data.naturalY :\n          (data.natural_y !== undefined ? data.natural_y : 0));\n  const anchorLabel = data.anchorLabel || data.anchor_label || data.label || '';\n  return {\n    conversationId: String(conversationId),\n    nodeId: String(nodeId),\n    naturalX: isNaN(naturalX) ? 0 : naturalX,\n    naturalY: isNaN(naturalY) ? 0 : naturalY,\n    anchorLabel: String(anchorLabel || ''),\n    ...data,\n  };\n}\n\n/**\n * Adds or updates an anchor in the in-memory session cache and node data.\n * @param {!Object} anchor\n */\nfunction addOrUpdateConversationAnchor(anchor) {\n  if (!anchor) return;\n  const normalized = normalizeAnchor(anchor);\n  if (!normalized || !normalized.conversationId) return;\n\n  const idx = sessionConversationAnchors.findIndex(\n      a => a.conversationId === normalized.conversationId);\n  if (idx >= 0) {\n    sessionConversationAnchors[idx] =\n        Object.assign({}, sessionConversationAnchors[idx], normalized);\n  } else {\n    sessionConversationAnchors.push(normalized);\n  }\n\n  // Also sync into nodesData[nodeId].conversationAnchors\n  if (nodesData && nodesData[normalized.nodeId]) {\n    nodesData[normalized.nodeId].conversationAnchors =\n        nodesData[norma