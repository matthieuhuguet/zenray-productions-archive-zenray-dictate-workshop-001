} else {\n      nodesData[normalized.nodeId].conversationAnchors.push(normalized);\n    }\n  }\n}\n\n/**\n * Removes an anchor by conversationId from session cache and nodesData.\n * @param {string} conversationId\n */\nfunction removeConversationAnchor(conversationId) {\n  if (!conversationId) return;\n  const idStr = String(conversationId);\n  if (activeConversationId === idStr) {\n    exitConversationInteractionMode(/* opt_notifyParent= */ false);\n  }\n  sessionConversationAnchors =\n      sessionConversationAnchors.filter(a => a.conversationId !== idStr);\n\n  if (nodesData) {\n    Object.values(nodesData).forEach(node => {\n      if (node && node.conversationAnchors &&\n          Array.isArray(node.conversationAnchors)) {\n        node.conversationAnchors = node.conversationAnchors.filter(\n            a => (a.conversationId || a.conversation_id) !== idStr);\n      }\n    });\n  }\n}\n\n/**\n * Initializes embedded conversation anchors from nodesData, static\n * placeholders, or global object.\n */\nfunction initConversationAnchors() {\n  // 1. Load from static placeholder if provided\n  if (Array.isArray(staticConversationAnchors)) {\n    staticConversationAnchors.forEach(a => addOrUpdateConversationAnchor(a));\n  } else if (\n      staticConversationAnchors &&\n      typeof staticConversationAnchors === 'object') {\n    Object.values(staticConversationAnchors).forEach(val => {\n      if (Array.isArray(val)) {\n        val.forEach(a => addOrUpdateConversationAnchor(a));\n      } else {\n        addOrUpdateConversationAnchor(val);\n      }\n    });\n  }\n\n  // 2. Load from global window.__CONVERSATION_ANCHORS__ if present\n  if (typeof window !== 'undefined' &&\n      Array.isArray(window.__CONVERSATION_ANCHORS__)) {\n    window.__CONVERSATION_ANCHORS__.forEach(\n        a => addOrUpdateConversationAnchor(a));\n  }\n\n  // 3. Scan nodesData across all nodes for pre-injected anchors\n  if (typeof nodesData !== 'undefined' && nodesData) {\n    Object.keys(nodes