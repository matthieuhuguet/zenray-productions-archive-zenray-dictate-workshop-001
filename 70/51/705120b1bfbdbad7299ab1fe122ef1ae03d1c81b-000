udgeReturnTimeoutId = null;\n    hasNudgedOrInteracted = true;\n\n    // Clear transitions after return animation completes (500ms later)\n    setTimeout(() => {\n      mainImage.style.transition = '';\n      if (labelsContainer) {\n        labelsContainer.style.transition = '';\n      }\n      const tEl = document.getElementById('onboarding-tooltip');\n      if (tEl) {\n        tEl.style.transition = '';\n      }\n    }, 500);\n  }, 600);\n}\n\n\n\n/**\n * @fileoverview Sequence (time-step) link type.\n *\n * Adds a second kind of edge on top of the hierarchical zoom: a child with\n * `nodeType: 'sequence'` is drawn as an amber timeline hotspot on its parent,\n * and tapping it does NOT zoom into the label. Instead:\n *   1. the hotspot pill morphs (FLIP) into a compact dot-scrubber rail docked\n *      at the bottom of the viewport (top on narrow screens), and\n *   2. the scene crossfades \u2014 camera locked, no zoom \u2014 through an ordered list\n *      of step nodes, each an ordinary node with its own image, text and\n *      hotspots.\n *\n * Node schema (layer_json / nodesData):\n *   sequence container:\n *     { id, parentId, nodeType: 'sequence', label, labelPosition, box,\n *       childrenIds: [...stepIds],          // keeps it non-terminal\n *       sequence: { title, timeStyle: 'relative'|'age'|'absolute'|'ordinal',\n *                   stepIds: [...], loop: false } }\n *   step:\n *     { id, parentId, imageSrc, label, text, childrenIds,\n *       timeLabel: 'T+10 min', timeSeconds: 600, timeAbsolute: '...' }\n *\n * Concatenated into the shell's single IIFE by compile_template.py, so it\n * shares scope with renderNode / nodesData / mainImage / textPanel.\n * Entry points used by other shell files:\n *   isSequenceNode, decorateSequenceLabel (label_placement_and_render.js),\n *   enterSequence (zoom_transitions.js), onSequenceRenderNode\n *   (immersive_world_shell.js).\n */\n\nconst SEQ_FADE_MS = 650;\nconst SEQ_MORPH_MS = 620;\nconst SEQ_YEAR_S = 3.156e7;\n\nconst sequenceState = {\n  active: false,\n  seqId: null,\n  stepIds: [],\n  idx: 0,\n  countRaf: 0,\n  internalRender: false,\n  rail: null,\n};\n\n/**\n * @param {?Object} node\n * @return {boolean}\n */\nfunction isSequenceNode(node) {\n  return !!(\n      node && node.nodeType === 'sequence' && node.sequence &&\n      Array.isArray(node.sequence.stepIds) && node.sequence.stepIds.length > 0);\n}\n\n/**\n * @param {*} s\n * @return {string}\n */\nfunction seqEscape(s) {\n  return String(s == null ? '' : s)\n      .replace(\n          /[&<>\"]/g,\n          (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;'}[c]));\n}\n\n/**\n * Formats seconds-after-event as a relative time label (\"T+10 min\").\n * @param {number} sec\n * @return {string}\n */\nfunction seqFormatRelative(sec) {\n  if (sec < 1) return 'T+0';\n  if (sec < 3600) return `T+${Math.max(1, Math.round(sec / 60))} min`;\n  if (sec < 86400) return `T+${Math.round(sec / 3600)} hr`;\n  if (sec < SEQ_YEAR_S) return `T+${Math.round(sec / 86400)} days`;\n  const y = sec / SEQ_YEAR_S;\n  if (y < 1000) return `T+${Math.round(y).toLocaleString()} yr`;\n  if (y < 1e6) return `T+${Math.round(y / 1000)}k yr`;\n  return `T+${(y / 1e6).toFixed(1).replace(/\\.0$/, '')}M yr`;\n}\n\n/** @return {!Object} The open sequence container node. */\nfunction seqNode() {\n  return nodesData[sequenceState.seqId];\n}\n\n/**\n * @param {number=} i Step index; defaults to the current step.\n * @return {!Object} The step node.\n */\nfunction seqStep(i = sequenceState.idx) {\n  return nodesData[sequenceState.stepIds[i]];\n}\n\n/**\n * Called from renderLabels before the pill is measured.\n * @param {!Element} label\n * @param {string} childId\n */\nfunction decorateSequenceLabel(label, childId) {\n  const node = nodesData[childId];\n  if (!isSequenceNode(node)) return;\n  const steps =\n      node.sequence.stepIds.map((id) => nodesData[id]).filter(Boolean);\n  const span = steps.length ?\n      `${steps.length} stages \u00b7 ${steps[0].timeLabel || ''} \u2192 ${\n          steps[steps.length - 1].timeLabel || ''}` :\n      '';\n  label.classList.add('sequence-entry');\n  label.innerHTML =\n      '<span class=\"seq-entry-icon google-symbols\">timeline</span>' +\n      '<span class=\"seq-entry-text\">' +\n      `<span class=\"seq-entry-title\">${\n          seqEscape(stripRabbitEmoji(node.label))}</span>` +\n      `<span class=\"seq-entry-sub\">${seqEscape(span)}</span></span>`;\n}\n\n// -----------------------------------------------------------------------------\n// Timeline rail\n// -----------------------------------------------------------------------------\n\n/**\n * Short tick label under a dot: \"T+0\", \"10 min\", \"1 day\", ... (the \"T+\" is\n * implied after the first stop).\n * @param {?Object} s\n * @param {number} i\n * @return {string}\n */\nfunction seqTickLabel(s, i) {\n  const t = (s && s.timeLabel) || `${i + 1}`;\n  return i === 0 ? t : t.replace(/^T\\+\\s*/, '');\n}\n\n/**\n * Builds the compact rail (one row, no thumbnails):\n *   T+10 min            \u2039  \u25cf\u2500\u2500\u2500\u2500\u25c9\u2500\u2500\u2500\u2500\u25cb\u2500\u2500\u2500\u2500\u25cb\u2500\u2500\u2500\u2500\u25cb\u2500\u2500\u2500\u2500\u25cb  \u203a   \u2715\n *   66,043,000 yrs ago     T+0 10 min 1 day 1 yr 1k yr 1M yr\n * Left: where we are in time (relative, then absolute). Middle: evenly spaced\n * clickable stops. The stage title lives in the breadcrumb and text panel.\n * @return {!Element}\n */\nfunction seqBuildRail() {\n  const seq = seqNode();\n  const steps = sequenceState.stepIds.map((id) => nodesData[id]);\n  const n = steps.length;\n  const rail = document.createElement('div');\n  rail.className = 'seq-rail';\n  rail.setAttribute('role', 'group');\n  rail.setAttribute(\n      'aria-label', `${seq.sequence.title || seq.label} timeline`);\n  rail.innerHTML = `\n    <div class=\"seq-rail-inner\">\n      <div class=\"seq-now\">\n        <span class=\"seq-time\" aria-live=\"polite\"></span>\n        <span class=\"seq-abs\"></span>\n      </div>\n      <button class=\"seq-btn seq-prev\" aria-label=\"Previous stage\"><span class=\"google-symbols\">chevron_left</span></button>\n      <div class=\"seq-track\" style=\"--n:${n}\">\n        <div class=\"seq-line\"><b></b></div>\n      </div>\n      <button class=\"seq-btn seq-next\" aria-label=\"Next stage\"><span class=\"google-symbols\">chevron_right</span></button>\n      <button class=\"seq-btn seq-close\" aria-label=\"Exit timeline\"><span class=\"google-symbols\">close</span></button>\n    </div>`;\n  const track = rail.querySelector('.seq-track');\n  steps.forEach((s, i) => {\n    const stop = document.createElement('button');\n    stop.className = 'seq-stop';\n    stop.style.setProperty('--i', String(i));\n    stop.title = [s.timeLabel, s.label].filter(Boolean).join(' \u00b7 ');\n    stop.setAttribute('aria-label', `Stage ${i + 1} of ${n}: ${stop.title}`);\n    stop.innerHTML = '<span class=\"seq-dot\"></span>' +\n        `<span class=\"seq-tick\">${seqEscape(seqTickLabel(s, i))}</span>`;\n    stop.addEventListener('click', (e) => {\n      e.stopPropagation();\n      seqGoStep(i);\n    });\n    track.appendChild(stop);\n  });\n  const on = (sel, fn) =>\n      rail.querySelector(sel).addEventListener('click', (e) => {\n        e.stopPropagation();\n        fn();\n      });\n  on('.seq-prev', () => seqGoStep(sequenceState.idx - 1));\n  on('.seq-next', () => seqGoStep(sequenceState.idx + 1));\n  on('.seq-close', exitSequence);\n  // Keep rail gestures away from the canvas pan/zoom handlers.\n  ['pointerdown', 'mousedown', 'touchstart', 'wheel', 'dblclick'].forEach(\n      (t) => rail.addEventListener(\n          t, (e) => e.stopPropagation(), {passive: true}));\n  document.body.appendChild(rail);\n  return rail;\n}\n\n/** Syncs the rail's stops, progress line and buttons to the current step. */\nfunction seqUpdateRail() {\n  const rail = sequenceState.rail;\n  if (!rail) return;\n  const n = sequenceState.stepIds.length;\n  const i = sequenceState.idx;\n  const s = seqStep();\n  rail.querySelector('.seq-abs').textContent =\n      s.timeAbsolute || `Stage ${i + 1} of ${n}`;\n  rail.querySelectorAll('.seq-stop').forEach((c, k) => {\n    c.classList.toggle('active', k === i);\n    c.classList.toggle('done', k < i);\n    c.setAttribute('aria-current', k === i ? 'step' : 'false');\n  });\n  rail.querySelector('.seq-line b').style.width =\n      n > 1 ? `${(i / (n - 1)) * 100}%` : '0';\n  rail.querySelector('.seq-prev').disabled = i === 0;\n  rail.querySelector('.seq-next').disabled = i === n - 1;\n}\n\n/**\n * Sets the rail's time label, counting up on a log scale when moving forward.\n * @param {string} label\n * @param {?number=} fromSec\n * @param {?number=} toSec\n */\nfunction seqSetTime(label, fromSec = null, toSec = null) {\n  const t = sequenceState.rail && sequenceState.rail.querySelector('.seq-time');\n  if (!t) return;\n  cancelAnimationFrame(sequenceState.countRaf);\n  t.classList.remove('counting');\n  const style = seqNode().sequence.timeStyle || 'relative';\n  if (fromSec == null || toSec == null || !(toSec > fromSec) ||\n      style !== 'relative') {\n    t.textContent = label;\n    return;\n  }\n  const a = Math.log10(fromSec + 1);\n  const b = Math.log10(toSec + 1);\n  const t0 = performance.now();\n  const tick = (now) => {\n    const p = Math.min(1, (now - t0) / 900);\n    const e = 1 - Math.pow(1 - p, 3);\n    t.textContent =\n        p < 1 ? seqFormatRelative(Math.pow(10, a + (b - a) * e) - 1) : label;\n    t.classList.toggle('counting', p < 1);\n    if (p < 1) sequenceState.countRaf = requestAnimationFrame(tick);\n  };\n  sequenceState.countRaf = requestAnimationFrame(tick);\n}\n\n/**\n * FLIP morph between the hotspot pill and the docked rail.\n * @param {!Element} rail\n * @param {?DOMRect} pillRect\n * @param {boolean} reverse true = rail collapses back into the pill.\n * @param {function()=} done\n */\nfunction seqMorphRail(rail, pillRect, reverse, done) {\n  const inner = rail.querySelector('.seq-rail-inner');\n  const to = rail.getBoundingClientRect();\n  const canAnimate = !!(pillRect && to.width && rail.animate);\n  if (!canAnimate) {\n    rail.classList.toggle('seq-shown', !reverse);\n    if (done) setTimeout(done, 300);\n    return;\n  }\n  const dx = (pillRect.left + pillRect.width / 2) - (to.left + to.width / 2);\n  const dy = (pillRect.top + pillRect.height / 2) - (to.top + to.height / 2);\n  const sx = pillRect.width / to.width;\n  const sy = pillRect.height / to.height;\n  const pillT = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;\n  const frames = [\n    {transform: pillT, borderRadius: '10px', opacity: 0.7},\n    {transform: 'none', borderRadius: '22px', opacity: 1},\n  ];\n  const anim = rail.animate(reverse ? frames.slice().reverse() : frames, {\n    duration: SEQ_MORPH_MS,\n    easing: 'cubic-bezier(.2, .8, .2, 1)',\n    fill: 'both',\n  });\n  inner.animate(\n      reverse ? [{opacity: 1}, {opacity: 0}] :\n                [{opacity: 0}, {opacity: 0}, {opacity: 1}],\n      {\n        duration: reverse ? SEQ_MORPH_MS * 0.4 : SEQ_MORPH_MS + 200,\n        fill: 'both'\n      });\n  rail.classList.add('seq-shown');\n  anim.onfinish = () => {\n    if (done) done();\n  };\n}\n\n// -----------------------------------------------------------------------------\n// Scene crossfade (camera locked)\n// -----------------------------------------------------------------------------\n\n/**\n * Covers the main image with a snapshot of the current frame; fading the\n * snapshot out then reveals the next render underneath (camera-locked\n * crossfade).\n * @return {?HTMLImageElement} The overlay, or null if there is no image yet.\n */\nfunction seqSnapshotOverlay() {\n  if (!mainImage || !mainImage.getAttribute('src')) return null;\n  const parent = mainImage.parentElement;\n  const r = mainImage.getBoundingClientRect();\n  const pr = parent.getBoundingClientRect();\n  const cs = getComputedStyle(mainImage);\n  const overlay = document.createElement('img');\n  overlay.className = 'seq-fade-overlay';\n  overlay.alt = '';\n  overlay.src = mainImage.currentSrc || mainImage.src;\n  Object.assign(overlay.style, {\n    left: `${r.left - pr.left}px`,\n    top: `${r.top - pr.top}px`,\n    width: `${r.width}px`,\n    height: `${r.height}px`,\n    objectFit: cs.objectFit,\n    objectPosition: cs.objectPosition,\n  });\n  mainImage.insertAdjacentElement('afterend', overlay);\n  return overlay;\n}\n\n/** @param {string} nodeId */\nfunction seqRenderWithCrossfade(nodeId) {\n  const overlay = seqSnapshotOverlay();\n  sequenceState.internalRender = true;\n  try {\n    renderNode(nodeId);\n  } finally {\n    sequenceState.internalRender = false;\n  }\n  if (!overlay) return;\n  let faded = false;\n  const fade = () => {\n    if (faded) return;\n    faded = true;\n    overlay.style.transition = `opacity ${SEQ_FADE_MS}ms ease`;\n    overlay.style.opacity = '0';\n    setTimeout(() => overlay.remove(), SEQ_FADE_MS + 50);\n  };\n  if (mainImage.complete) {\n    requestAnimationFrame(() => requestAnimationFrame(fade));\n  } else {\n    mainImage.addEventListener('load', fade, {once: true});\n    setTimeout(fade, 1500);\n  }\n}\n\n// -----------------------------------------------------------------------------\n// Navigation\n// -----------------------------------------------------------------------------\n\n/** @param {number} i */\nfunction seqGoStep(i) {\n  if (!sequenceState.active) return;\n  i = Math.max(0, Math.min(sequenceState.stepIds.length - 1, i));\n  if (i === sequenceState.idx) return;\n  const prev = seqStep();\n  const forward = i > sequenceState.idx;\n  sequenceState.idx = i;\n  const s = seqStep();\n  seqRenderWithCrossfade(s.id);\n  seqUpdateRail();\n  seqSetTime(\n      s.timeLabel || '', forward ? prev.timeSeconds : null, s.timeSeconds);\n  if (typeof emitUserInteraction === 'function') {\n    emitUserInteraction('SEQUENCE_STEP', {\n      targe