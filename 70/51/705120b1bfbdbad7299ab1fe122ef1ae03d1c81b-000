rk-theme .conversation-anchor-point {\n    background: #8ab4f8;\n    box-shadow: 0 0 8px rgba(138, 180, 248, 0.8);\n}\n\nbody.immersive-active .conversation-anchor-halo,\nbody.dark-theme .conversation-anchor-halo {\n    background: radial-gradient(circle, rgba(138, 180, 248, 0.45) 0%, rgba(138, 180, 248, 0) 72%);\n}\n\nbody.immersive-active .conversation-bubble-delete,\nbody.dark-theme .conversation-bubble-delete {\n    background: rgba(255, 255, 255, 0.15);\n    color: #e8eaed;\n}\n\nbody.immersive-active .conversation-bubble-delete:hover,\nbody.dark-theme .conversation-bubble-delete:hover {\n    background: rgba(242, 139, 130, 0.25);\n    color: #f28b82;\n}\n\nbody.immersive-active .conversation-anchor-pin.conversation-anchor-pin--active .conversation-anchor-point,\nbody.dark-theme .conversation-anchor-pin.conversation-anchor-pin--active .conversation-anchor-point {\n    background: #8ab4f8;\n    box-shadow: 0 0 0 3px rgba(138, 180, 248, 0.4), 0 0 12px rgba(138, 180, 248, 0.9);\n}\n\nbody.immersive-active .conversation-anchor-pin.conversation-anchor-pin--active .conversation-anchor-halo,\nbody.dark-theme .conversation-anchor-pin.conversation-anchor-pin--active .conversation-anchor-halo {\n    background: radial-gradient(circle, rgba(138, 180, 248, 0.65) 0%, rgba(138, 180, 248, 0) 75%);\n}\n\nbody.immersive-active .conversation-anchor-pin.conversation-anchor-pin--active .conversation-chat-bubble,\nbody.dark-theme .conversation-anchor-pin.conversation-anchor-pin--active .conversation-chat-bubble {\n    background: rgba(45, 46, 50, 0.98);\n    border-color: #8ab4f8;\n    box-shadow: 0 6px 24px rgba(138, 180, 248, 0.4), 0 2px 8px rgba(0, 0, 0, 0.5);\n}\n\nbody.immersive-active .conversation-anchor-pin.conversation-anchor-pin--active .conversation-chat-bubble::after,\nbody.dark-theme .conversation-anchor-pin.conversation-anchor-pin--active .conversation-chat-bubble::after {\n    border-top-color: rgba(45, 46, 50, 0.98);\n}\n\nbody.immersive-active .conversation-anchor-pin.conversation-anchor-pin--active.flip-down .conversation-chat-bubble::after,\nbody.dark-theme .conversation-anchor-pin.conversation-anchor-pin--active.flip-down .conversation-chat-bubble::after {\n    border-bottom-color: rgba(45, 46, 50, 0.98);\n}\n\n\n\n\n\n/**\n * Progressive DeepZoom Feedback Questionnaire Modal & Exact Design Tokens\n * Matched strictly to Figma specification.\n */\n\n:root {\n  --fb-font-family: 'Google Sans', 'Google Sans Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  --fb-card-bg: #fff;\n  --fb-card-color: #1f1f1f;\n  --fb-card-subtext: #444746;\n  --fb-pill-bg: #f0f2f5;\n  --fb-pill-hover: #e4e7ec;\n  --fb-pill-selected: #e8f0fe;\n  --fb-checkbox-border: #444746;\n  --fb-checkbox-selected: #1f1f1f;\n  --fb-circle-border: #444746;\n  --fb-circle-selected: #1f1f1f;\n  --fb-btn-primary-bg: #7eb4fc;\n  --fb-btn-primary-color: #041e49;\n  --fb-btn-cancel-color: #1f1f1f;\n  --fb-card-radius: 28px;\n  --fb-pill-radius: 24px;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fb-card-bg: #282a2d;\n    --fb-card-color: #e3e3e3;\n    --fb-card-subtext: #c4c7c5;\n    --fb-pill-bg: #35373a;\n    --fb-pill-hover: #3f4246;\n    --fb-pill-selected: rgba(126, 180, 252, 0.16);\n    --fb-checkbox-border: #8e918f;\n    --fb-checkbox-selected: #7eb4fc;\n    --fb-circle-border: #8e918f;\n    --fb-circle-selected: #7eb4fc;\n    --fb-btn-primary-bg: #7eb4fc;\n    --fb-btn-primary-color: #041e49;\n    --fb-btn-cancel-color: #e3e3e3;\n  }\n}\n\n/* Feedback Button in Toolbar */\n#lightbox-feedback-button.lightbox-feedback-button--hidden {\n  display: none !important;\n}\n\n#lightbox-feedback-share-group:not(:has(button:not(.lightbox-feedback-button--hidden):not(.lightbox-share-button--hidden):not(.lightbox-inline-conversation-button--hidden))) {\n  display: none !important;\n}\n\n/* Modal Backdrop */\n#deepzoom-feedback-modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.6);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  z-index: 100000000;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  transition: opacity 0.22s ease-out;\n  padding: 16px;\n  box-sizing: border-box;\n}\n\n#deepzoom-feedback-modal.visible {\n  display: flex;\n  opacity: 1;\n}\n\n/* Modal Card */\n.feedback-modal-card {\n  position: relative;\n  width: 380px;\n  max-width: 100%;\n  max-height: calc(100vh - 32px);\n  overflow-y: auto;\n  scrollbar-width: none;\n  background: var(--fb-card-bg);\n  border-radius: var(--fb-card-radius);\n  padding: 24px;\n  box-sizing: border-box;\n  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.22);\n  color: var(--fb-card-color);\n  font-family: var(--fb-font-family);\n  transform: scale(0.96);\n  transition: transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1);\n}\n\n.feedback-modal-card::-webkit-scrollbar {\n  display: none;\n}\n\n#deepzoom-feedback-modal.visible .feedback-modal-card {\n  transform: scale(1);\n}\n\n/* Close Button */\n.feedback-modal-close-btn {\n  position: absolute;\n  top: 18px;\n  right: 18px;\n  background: transparent;\n  border: none;\n  border-radius: 50%;\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--fb-card-subtext);\n  cursor: pointer;\n  transition: background-color 0.18s, color 0.18s;\n  z-index: 2;\n}\n\n#deepzoom-feedback-modal[dir='rtl'] .feedback-modal-close-btn {\n  right: auto;\n  left: 18px;\n}\n\n.feedback-modal-close-btn:hover {\n  background: var(--fb-pill-hover);\n  color: var(--fb-card-color);\n}\n\n/* Header */\n.feedback-modal-header {\n  margin-bottom: 12px;\n  padding-right: 32px;\n}\n\n#deepzoom-feedback-modal[dir='rtl'] .feedback-modal-header {\n  padding-right: 0;\n  padding-left: 32px;\n}\n\n.feedback-modal-title {\n  font-size: 20px;\n  font-weight: 400;\n  line-height: 26px;\n  margin: 0;\n  color: var(--fb-card-color);\n  letter-spacing: -0.2px;\n}\n\n/* Screen Transitions */\n.feedback-screen {\n  display: none;\n  opacity: 0;\n  transition: opacity 0.18s ease-in-out;\n}\n\n.feedback-screen.active {\n  display: block;\n  opacity: 1;\n}\n\n/* Screen 1: Minimalist Thumbs */\n.feedback-question-prompt {\n  font-size: 14px;\n  font-weight: 400;\n  text-align: center;\n  color: var(--fb-card-subtext);\n  margin-bottom: 20px;\n}\n\n.feedback-minimal-sentiment-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 24px;\n  padding: 8px 0 20px 0;\n}\n\n.feedback-icon-btn {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  background: var(--fb-pill-bg);\n  border: 1px solid transparent;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: var(--fb-card-color);\n  transition: all 0.2s cubic-bezier(0.2, 0.9, 0.3, 1);\n}\n\n.feedback-thumb-icon {\n  font-size: 28px;\n  line-height: 1;\n}\n\n.feedback-thumb-up-btn:hover {\n  background: rgba(109, 213, 140, 0.2);\n  border-color: #6dd58c;\n  color: #1e8e3e;\n  transform: scale(1.08);\n}\n\n.feedback-thumb-down-btn:hover {\n  background: rgba(242, 184, 181, 0.2);\n  border-color: #f2b8b5;\n  color: #d93025;\n  transform: scale(1.08);\n}\n\n/* Screen 2 & 3 Question Groups */\n.feedback-question-group {\n  margin-bottom: 14px;\n}\n\n.feedback-prompt-main {\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 20px;\n  color: var(--fb-card-subtext);\n}\n\n.feedback-prompt-sub {\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 20px;\n  color: var(--fb-card-subtext);\n  margin-top: 1px;\n}\n\n/* Screen 2: Stacked Option Pills (Figma Exact) */\n.feedback-options-list {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  margin-bottom: 20px;\n}\n\n.feedback-option-pill {\n  min-height: 52px;\n  height: auto;\n  border-radius: 4px;\n  background: var(--fb-pill-bg);\n  border: 1.5px solid transparent;\n  padding: 10px 20px;\n  gap: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  cursor: pointer;\n  text-align: start;\n  width: 100%;\n  box-sizing: border-box;\n  color: var(--fb-card-color);\n  font-family: var(--fb-font-family);\n  transition: background-color 0.18s, border-color 0.18s;\n}\n\n.feedback-option-pill:first-child {\n  border-top-left-radius: 20px;\n  border-top-right-radius: 20px;\n  border-bottom-left-radius: 4px;\n  border-bottom-right-radius: 4px;\n}\n\n.feedback-option-pill:last-child {\n  border-top-left-radius: 4px;\n  border-top-right-radius: 4px;\n  border-bottom-left-radius: 20px;\n  border-bottom-right-radius: 20px;\n}\n\n.feedback-option-pill:only-child {\n  border-radius: 20px;\n}\n\n.feedback-option-pill:hover {\n  background: var(--fb-pill-hover);\n}\n\n.feedback-pill-label {\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 18px;\n  color: inherit;\n}\n\n.feedback-pill-indicator {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  color: var(--fb-checkbox-border, var(--fb-circle-border));\n}\n\n.feedback-checkbox-icon.checkbox-unchecked,\n.feedback-circle-icon.circle-unchecked {\n  display: inline-block;\n}\n\n.feedback-checkbox-icon.checkbox-checked,\n.feedback-circle-icon.circle-checked {\n  display: none;\n}\n\n.feedback-option-pill.selected {\n  background: var(--fb-pill-selected);\n  color: var(--fb-card-color);\n}\n\n.feedback-option-pill.selected .feedback-pill-indicator {\n  color: var(--fb-checkbox-selected, var(--fb-circle-selected));\n}\n\n.feedback-option-pill.selected .checkbox-unchecked,\n.feedback-option-pill.selected .circle-unchecked {\n  display: none;\n}\n\n.feedback-option-pill.selected .checkbox-checked,\n.feedback-option-pill.selected .circle-checked {\n  display: inline-block;\n}\n\n/* Screen 3 / Integrated Comment Input (Bottom Child) */\n.feedback-input-wrapper {\n  margin: 0;\n  width: 100%;\n}\n\n.feedback-pill-input {\n  width: 100%;\n  height: 52px;\n  border-radius: 4px 4px 20px 20px;\n  background: var(--fb-pill-bg);\n  border: 1.5px solid transparent;\n  padding: 0 20px;\n  font-family: var(--fb-font-family);\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 20px;\n  color: var(--fb-card-color);\n  box-sizing: border-box;\n  outline: none;\n  transition: border-color 0.2s, background-color 0.2s;\n}\n\n.feedback-pill-input:focus {\n  border-color: var(--fb-btn-primary-bg);\n  background: var(--fb-card-bg);\n}\n\n.feedback-pill-input::placeholder {\n  color: var(--fb-card-subtext);\n  font-size: 14px;\n  font-weight: 400;\n}\n\n/* Footer Actions */\n.feedback-footer-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 4px;\n}\n\n.feedback-action-cancel {\n  height: 38px;\n  padding: 0 16px;\n  border-radius: 19px;\n  border: none;\n  background: transparent;\n  color: var(--fb-btn-cancel-color);\n  font-family: var(--fb-font-family);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 0.18s;\n}\n\n.feedback-action-cancel:hover {\n  background: var(--fb-pill-bg);\n}\n\n.feedback-action-connect {\n  height: 38px;\n  padding: 0 22px;\n  border-radius: 19px;\n  border: none;\n  background: var(--fb-btn-primary-bg);\n  color: var(--fb-btn-primary-color);\n  font-family: var(--fb-font-family);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: opacity 0.18s, transform 0.18s;\n}\n\n.feedback-action-connect:hover {\n  opacity: 0.9;\n  transform: scale(1.02);\n}\n\n@media (max-height: 540px) {\n  .feedback-modal-card {\n    padding: 18px;\n    border-radius: 22px;\n  }\n  .feedback-modal-header {\n    margin-bottom: 8px;\n  }\n  .feedback-option-pill {\n    min-height: 40px;\n    height: auto;\n    padding: 8px 16px;\n    font-size: 13px;\n  }\n  .feedback-option-pill:first-child {\n    border-top-left-radius: 16px;\n    border-top-right-radius: 16px;\n    border-bottom-left-radius: 4px;\n    border-bottom-right-radius: 4px;\n  }\n  .feedback-option-pill:last-child {\n    border-top-left-radius: 4px;\n    border-top-right-radius: 4px;\n    border-bottom-left-radius: 16px;\n    border-bottom-right-radius: 16px;\n  }\n  .feedback-pill-input {\n    height: 38px;\n    font-size: 13px;\n    padding: 0 14px;\n    border-radius: 19px;\n  }\n  .feedback-action-cancel,\n  .feedback-action-connect {\n    height: 34px;\n    font-size: 13px;\n  }\n}\n\n\n/* Sequence (time-step) link type \u2014 see scripts/sequence_stepper.js */\n\n:root {\n  --seq-amber: #ffb74d;\n  --seq-amber-soft: rgba(255, 183, 77, 0.35);\n  --seq-glass: rgba(22, 22, 26, 0.72);\n  --seq-line: rgba(255, 255, 255, 0.18);\n}\n\n/* ---------- Entry hotspot ----------\n * Same frosted-glass pill as regular callouts (the shell's\n * `body.immersive-config-active .label` rule uses !important, so selectors here\n * are prefixed to out-rank it), plus an amber timeline badge and a time-span\n * line. */\nbody .label.sequence-entry,\nbody.immersive-config-active .label.sequence-entry {\n  display: inline-flex !important;\n  align-items: center;\n  gap: 8px;\n  height: 42px !important;\n  padding: 2px 16px 2px 6px !important;\n  background-color: rgba(255, 255, 255, 0.72) !important;\n  box-shadow: 0 0 0 1.5px var(--seq-amber), 0 0 18px rgba(255, 183, 77, 0.45) !important;\n  font-style: normal !important;\n  line-height: 1.15 !important;\n  white-space: nowrap;\n}\n.label.sequence-entry .seq-entry-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  background: var(--seq-amber);\n  color: #3b2300;\n  font-size: 20px;\n  font-variation-settings: 'FILL' 1;\n}\n.label.sequence-entry .seq-entry-text { display: flex; flex-direction: column; }\n.label.sequence-entry .seq-entry-sub {\n  font-family: 'Google Sans', sans-serif;\n  font-size: 11px;\n  font-style: normal;\n  color: #7a4a00;\n  margin-top: 1px;\n}\n.sequence-dot .anchor-dot-inner,\ncircle.anchor-dot.sequence-dot {\n  stroke: var(--seq-amber) !important;\n}\n.sequence-dot .anchor-dot-outer {\n  stroke: var(--seq-amber) !important;\n  stroke-opacity: 0.85;\n  stroke-width: 2px !important;\n  stroke-dasharray: 4 4;\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: seq-spin 6s linear infinite;\n}\n@keyframes seq-spin { to { transform: rotate(360deg); } }\n\n/* ---------- Crossfade overlay ---------- */\n.seq-fade-overlay {\n  position: absolute;\n  pointer-events: none;\n  z-index: 1;\n  opacity: 1;\n}\n\n/* ---------- Timeline rail (compact dot scrubber) ---------- */\n.seq-rail {\n  position: fixed;\n  right: 16px;\n  bottom: 76px;\n  z-index: 60;\n  max-width: calc(100vw - 32px);\n  background: var(--seq-glass);\n  -webkit-backdrop-filter: blur(18px);\n  backdrop-filter: blur(18px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 999px;\n  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);\n  color: #f1f3f4;\n  font-family: 'Google Sans', sans-serif;\n  transform-origin: center center;\n  opacity: 0;\n}\n.seq-rail.seq-shown { opacity: 1; }\n.seq-rail-inner {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  height: 60px;\n  padding: 0 10px 0 22px;\n}\n\n/* Left: current time, relative over absolute. */\n.seq-now {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  min-width: 132px;\n  margin-right: 8px;\n  white-space: nowrap;\n}\n.seq-time {\n  font-size: 18px;\n  font-weight: 500;\n  line-height: 22px;\n  font-variant-numeric: tabular-nums;\n}\n.seq-time.counting { color: var(--seq-amber); }\n.seq-abs { font-size: 11px; line-height: 15px; color: rgba(241, 243, 244, 0.6); }\n\n/* Buttons. */\n.seq-btn {\n  width: 32px;\n  height: 32px;\n  flex: none;\n  border-radius: 50%;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n}\n.seq-btn .google-symbols { font-size: 22px; }\n.seq-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); }\n.seq-btn:disabled { opacity: 0.25; cursor: default; }\n.seq-btn:focus-visible,\n.seq-stop:focus-visible {\n  outline: 2px solid var(--seq-amber);\n  outline-offset: 2px;\n}\n.seq-btn.seq-close { margin-left: 4px; background: rgba(255, 255, 255, 0.08); }\n\n/* Middle: evenly spaced stops on a line. Each stop is 56px wide; the line\n * runs dot-center to dot-center and fills up to the active stop. */\n.seq-track {\n  --stop-w: 56px;\n  --dot-y: 13px; /* shared center line for dots + track line */\n  position: relative;\n  display: flex;\n  height: 44px;\n  width: calc(var(--n) * var(--stop-w));\n}\n.seq-line {\n  position: absolute;\n  left: calc(var(--stop-w) / 2);\n  right: calc(var(--stop-w) / 2);\n  top: calc(var(--dot-y) - 1px);\n  height: 2px;\n  border-radius: 1px;\n  background: rgba(255, 255, 255, 0.2);\n}\n.seq-line b {\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 0;\n  border-radius: 1px;\n  background: var(--seq-amber);\n  transition: width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);\n}\n.seq-stop {\n  position: relative;\n  flex: none;\n  width: var(--stop-w);\n  display: block;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  background: none;\n  border: 0;\n  border-radius: 8px;\n  color: inherit;\n  cursor: pointer;\n}\n.seq-dot {\n  position: absolute;\n  left: 50%;\n  top: var(--dot-y);\n  transform: translate(-50%, -50%);\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: #2a2a2e;\n  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.45);\n  transition: transform 0.3s, background 0.3s, box-shadow 0.3s;\n}\n.seq-stop:hover .seq-dot { box-shadow: inset 0 0 0 2px #fff; }\n.seq-stop.done .seq-dot { background: var(--seq-amber); box-shadow: none; }\n.seq-stop.active .seq-dot {\n  background: var(--seq-amber);\n  box-shadow: 0 0 0 4px var(--seq-amber-soft), 0 0 12px rgba(255, 183, 77, 0.6);\n  transform: translate(-50%, -50%) scale(1.3);\n}\n.seq-tick {\n  position: absolute;\n  left: 50%;\n  top: calc(var(--dot-y) + 11px);\n  transform: translateX(-50%);\n  font-size: 11px;\n  line-height: 13px;\n  color: rgba(241, 243, 244, 0.55);\n  white-space: nowrap;\n  transition: color 0.3s;\n}\n.seq-stop.done .seq-tick { color: rgba(241, 243, 244, 0.8); }\n.seq-stop.active .seq-tick { color: #fff; font-weight: 700; }\n\n/* Hide competing chrome while in a sequence. */\nbody.seq-active #onboarding-tooltip { display: none !important; }\n\n/* ---------- Mobile: dock at the top, drop chevrons/absolute time ---------- */\n@media (max-width: 640px) {\n  .seq-rail { left: 8px; right: 8px; top: 64px; bottom: auto; max-width: none; border-radius: 20px; }\n  .seq-rail-inner { padding: 0 6px 0 14px; justify-content: space-between; }\n  .seq-now { min-width: 0; margin-right: 4px; }\n  .seq-time { font-size: 15px; }\n  .seq-abs,\n  .seq-prev,\n  .seq-next {\n    display: none;\n  }\n  .seq-track { --stop-w: 42px; }\n  .seq-tick { font-size: 10px; }\n}\n\n    \x3c/style>\n</head>\n<body>\n    <div id=\"tour-overlay\" style=\"display: none;\"></div>\n\n    <audio id=\"tour-player\" style=\"display: none;\"></audio>\n\n    <div id=\"url-tooltip\"></div>\n    <div id=\"content-wrapper\">\n\n\n        <div id=\"image-text-wrapper\">\n            <div id=\"main-image-container\">\n                <img id=\"main-image\" src=\"\" alt=\"Interactive Content\">\n                <div id=\"region-highlight\"></div>\n                <button id=\"inline-explore-button\">\n                    <span class=\"google-symbols explore-icon\">touch_app</span>\n                    <span class=\"explore-label\">Explore</span>\n                </button>\n                <button id=\"lightbox-zoom-out-button\">\n                    <span class=\"google-symbols\">zoom_out</span>\n                </button>\n                <div id=\"lightbox-feedback-share-group\">\n                    <button id=\"lightbox-inline-conversation-button\" class=\"lightbox-inline-conversation-button--hidden\" title=\"Inline C