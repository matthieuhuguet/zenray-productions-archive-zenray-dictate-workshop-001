ocale === 'string' &&\n        window.deepZoomLocale.trim()) {\n      return window.deepZoomLocale.trim();\n    }\n    try {\n      const search = (typeof window !== 'undefined' && window.location) ?\n          window.location.search :\n          '';\n      if (search) {\n        const params = new URLSearchParams(search);\n        const urlLocale =\n            params.get('hl') || params.get('locale') || params.get('lang');\n        if (urlLocale && urlLocale.trim()) return urlLocale.trim();\n      }\n      if (typeof window !== 'undefined' && window.parent &&\n          window.parent !== window) {\n        try {\n          const parentParams =\n              new URLSearchParams(window.parent.location.search);\n          const parentLocale = parentParams.get('hl') ||\n              parentParams.get('locale') || parentParams.get('lang');\n          if (parentLocale && parentLocale.trim()) return parentLocale.trim();\n        } catch (e) {\n        }\n      }\n    } catch (e) {\n    }\n    if (typeof document !== 'undefined' && document.documentElement) {\n      const docLang = document.documentElement.getAttribute('lang');\n      if (docLang && docLang.trim() && docLang.trim().toLowerCase() !== 'en') {\n        return docLang.trim();\n      }\n    }\n    if (typeof navigator !== 'undefined') {\n      if (Array.isArray(navigator.languages) &&\n          navigator.languages.length > 0 && navigator.languages[0]) {\n        return navigator.languages[0];\n      }\n      if (typeof navigator.language === 'string' && navigator.language) {\n        return navigator.language;\n      }\n    }\n    return 'en';\n  }\n\n  /**\n   * Returns true if the given locale uses Right-to-Left (RTL) script direction.\n   * @param {?string} rawLocale\n   * @return {boolean}\n   */\n  function isRtlLocale(rawLocale) {\n    if (!rawLocale || typeof rawLocale !== 'string') return false;\n    const primary =\n        rawLocale.trim().replace(/_/g, '-').toLowerCase().split('-')[0];\n    return